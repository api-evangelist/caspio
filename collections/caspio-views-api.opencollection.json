{
  "opencollection": "1.0.0",
  "info": {
    "name": "Caspio REST Applications Views API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Views",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all views in the account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{account}.caspio.com/rest/v3/views"
          },
          "docs": "List all views in the account"
        },
        {
          "info": {
            "name": "Query view records",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{account}.caspio.com/rest/v3/views/:viewName/records",
            "params": [
              {
                "name": "viewName",
                "value": "",
                "type": "path"
              },
              {
                "name": "q.where",
                "value": "",
                "type": "query"
              },
              {
                "name": "q.limit",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Query view records"
        }
      ]
    }
  ],
  "bundled": true
}