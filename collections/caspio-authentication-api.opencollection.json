{
  "opencollection": "1.0.0",
  "info": {
    "name": "Caspio REST Applications Authentication API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Obtain an OAuth 2.0 access token (client credentials)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{account}.caspio.com/rest/v3/oauth/token",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "grant_type",
                  "value": ""
                },
                {
                  "name": "client_id",
                  "value": ""
                },
                {
                  "name": "client_secret",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Obtain an OAuth 2.0 access token (client credentials)"
        }
      ]
    }
  ],
  "bundled": true
}