{
  "opencollection": "1.0.0",
  "info": {
    "name": "Caspio REST Applications API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Applications",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Caspio applications",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{account}.caspio.com/rest/v3/applications"
          },
          "docs": "List Caspio applications"
        }
      ]
    }
  ],
  "bundled": true
}